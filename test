# 1. Add the old repository as a temporary source and download it
git remote add temp-origin <OLD_REPO_URL>
git fetch temp-origin

# 2. Merge the old history into your monorepo (ignores different roots)
git merge temp-origin/main --allow-unrelated-histories -m "Merge old repo history"

# 3. Create your destination subfolder (PowerShell syntax)
New-Item -ItemType Directory -Force -Path "<SUBFOLDER_NAME>"

# 4. Move all newly merged files into the subfolder (CRITICAL: Do this BEFORE removing the remote!)
git ls-tree --name-only temp-origin/main | ForEach-Object { git mv $_ "<SUBFOLDER_NAME>/" }

# 5. Clean up the temporary remote connection now that you are done with it
git remote remove temp-origin

# 6. Commit the move and push to your monorepo
git commit -m "Move old repo files into <SUBFOLDER_NAME>"
git push origin main